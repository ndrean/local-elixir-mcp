AI_API_URL=https://api.mistral.ai/v1
AI_API_KEY=your-mistral-api-key

AI_EMBED_MODEL=mistral-embed
AI_CHAT_MODEL_SMALL=mistral-small-latest
AI_CHAT_MODEL_LARGE=mistral-large-latest
GITHUB_API_URL=https://api.github.com

# GITHUB_TOKEN=xxx 

HEX_API_URL=https://hex.pm/api

# Local database (per project — two projects sharing one file overwrite each
# other's rows, since only one version per package is kept)
# DATABASE_PATH=/absolute/path/to/the/clone/priv/mcp-mistral.db

# .env is not loaded automatically. See README's Quickstart for explicit exports
# and an all-local Ollama setup using embeddinggemma plus llama3.2.

# Ingestion tuning — all optional, see README. A bad value falls back to the default.
# INGEST_TIMEOUT_MS=25000
# EMBED_BATCH_SIZE=200
# EMBED_CONCURRENCY=2
# EMBED_PAUSE_MS=0
