# Hosted setup: choose mistral (default) or openai and supply its API key.
AI_PROVIDER=mistral
AI_API_KEY=your-provider-api-key

# Memory curation is disabled by default. Enable to use remember; the provider
# supplies default chat models. recall can still search previously stored entries.
# MEMORY_ENABLED=true

# For local Ollama: AI_PROVIDER=ollama, no API key required.
# Run: ollama pull embeddinggemma
# Also pull llama3.2 if enabling memory. Keep Ollama running.

# Advanced overrides (otherwise supplied by the provider preset):
# AI_API_URL=https://api.mistral.ai/v1
# AI_EMBED_URL=https://api.mistral.ai/v1
# AI_CHAT_URL=https://api.mistral.ai/v1
# AI_EMBED_MODEL=mistral-embed
# AI_CHAT_MODEL_SMALL=mistral-small-latest
# AI_CHAT_MODEL_LARGE=mistral-large-latest
# DATABASE_PATH=/absolute/path/to/priv/mcp-mistral.db
# PROJECT_ROOT=/absolute/path/to/the/project/being/edited
# GITHUB_TOKEN=xxx
# INGEST_TIMEOUT_MS=25000
# EMBED_BATCH_SIZE=200
# EMBED_CONCURRENCY=2
# EMBED_PAUSE_MS=0

# .env is not loaded automatically. Export settings or set them in your MCP client.
# Use a separate database or reindex when changing embedding models/providers.
